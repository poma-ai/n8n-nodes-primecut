{
  "name": "n8n-nodes-primecut",
  "version": "0.1.0",
  "description": "n8n community node for PrimeCut by POMA AI: turn documents into chunks and chunksets for RAG pipelines",
  "license": "MIT",
  "homepage": "https://poma-ai.com",
  "keywords": [
    "n8n-community-node-package",
    "primecut",
    "poma",
    "chunking",
    "chunks",
    "rag",
    "documents",
    "pdf"
  ],
  "author": {
    "name": "POMA AI",
    "email": "rb@poma-ai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poma-ai/n8n-nodes-primecut.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PrimeCutApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PrimeCut/PrimeCut.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.53.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
